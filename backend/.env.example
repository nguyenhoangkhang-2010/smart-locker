DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_locker
DB_USER=postgres
DB_PASSWORD=change-me

# MQTT ingest. The default broker is public: pick your own topic prefix.
MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Required. A long random string, same value as include/secrets.h and
# cam/include/cam_config.h. Never commit the real one.
MQTT_TOPIC_PREFIX=CHANGE-ME-long-random-string
# MQTT_CLIENT_ID=smart-locker-backend   # change only for a second instance

LOCAL_UTC_OFFSET_HOURS=7
ALERT_COOLDOWN_MINUTES=10

# Optional: Telegram alerts (create a bot with @BotFather, get your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Face recognition (Phase 3)
FACE_MATCH_THRESHOLD=0.363
DEVICE_API_KEY=
CAMERA_ENABLED=false
CAMERA_DEVICE_ID=cam-01
