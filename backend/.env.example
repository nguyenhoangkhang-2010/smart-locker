# --- PostgreSQL (TimescaleDB khi chạy bằng docker compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_locker_v2
DB_USER=postgres
DB_PASSWORD=change-me

# --- MQTT (broker Mosquitto, TLS 8883; xem docs/CONTRACT.md) ---
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_FILE=../infra/certs/ca.crt
MQTT_CERT_FILE=../infra/certs/cloud.crt
MQTT_KEY_FILE=../infra/certs/cloud.key
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=locker-cloud

# --- Redis (để trống = dùng bộ nhớ trong, chỉ phù hợp khi phát triển) ---
REDIS_URL=

# --- JWT ES256: tạo khóa bằng  python -m app.cli gen-jwt-keys (hoặc đặt JWT_PRIVATE_KEY/JWT_PUBLIC_KEY là nội dung PEM) ---
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem
JWT_AUDIENCE=locker-api

# --- Cổng SMS/Zalo OA (trống = bản thử: OTP hiện trong bảng sms_outbox/dashboard) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_MAX_ATTEMPTS=5

# --- API ---
RATE_LIMIT_PER_MIN=300
HSTS=true
# API_TLS_CERT=/etc/letsencrypt/live/api.example.com/fullchain.pem
# API_TLS_KEY=/etc/letsencrypt/live/api.example.com/privkey.pem
